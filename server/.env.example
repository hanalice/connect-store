# BFF 监听端口
PORT=8787

# OpenAI-compatible 服务配置（G1.1 可留空，服务仍会启动）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 审批签名密钥：使用 openssl rand -base64 32 生成
APPROVAL_SECRET=

# dev 工具直调白名单（POST /api/tools/:toolName），逗号分隔工具名。
# 缺省 / 留空 = 白名单为空 = 任何工具都不可直调 —— 这就是正式生产语义（无 HITL 绕过面）；
# 仅本地开发 / QA 环境按下例开启。审批门控工具（placeOrder）永远不得加入白名单。
# TOOLS_DIRECT_ALLOW=searchCatalog,getProductDetails,addToCart
TOOLS_DIRECT_ALLOW=
