# BFF 监听端口
PORT=8787

# OpenAI-compatible 服务配置（G1.1 可留空，服务仍会启动）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 审批签名密钥：使用 openssl rand -base64 32 生成（缺省/留空 = placeOrder 策略恒 denied，
# 「宁可不可用，不可无签名放行」；演示/验收前必须配置）
APPROVAL_SECRET=

# HITL 金额阈值（美元，裁决③）：input.amount 大于阈值 → 'user-approval'，否则自动放行。
# 缺省 50；placeOrder 不受此阈值影响 —— 恒 'user-approval'（不可逆副作用不下放）。
APPROVAL_AMOUNT_THRESHOLD=50

# dev 工具直调白名单（POST /api/tools/:toolName），逗号分隔工具名。
# 缺省 / 留空 = 白名单为空 = 任何工具都不可直调 —— 这就是正式生产语义（无 HITL 绕过面）；
# 仅本地开发 / QA 环境按下例开启。审批门控工具（placeOrder）由 APPROVAL_GATED 黑名单
# 代码级剔除 —— 即使写入本变量也恒 404（裁决⑦，A7 注释级约束已升级为验收项）。
# TOOLS_DIRECT_ALLOW=searchCatalog,getProductDetails,addToCart
TOOLS_DIRECT_ALLOW=
